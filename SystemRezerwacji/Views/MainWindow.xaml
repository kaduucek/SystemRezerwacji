<Window x:Class="SystemRezerwacji.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SystemRezerwacji.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="System rezerwacji wizyt lekarskich" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen">
    <TabControl Margin="10">
        <TabItem Header="Wolne terminy">
            <views:CalendarView/>
        </TabItem>
        <TabItem Header="Nowa wizyta">
            <views:NowaWizytaView/>
        </TabItem>
        <TabItem Header="Moje wizyty">
            <views:WizytyView/>
        </TabItem>
    </TabControl>
</Window>
