<UserControl x:Class="SystemRezerwacji.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2000/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2000/xaml"
             Background="White">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Calendar Grid.Column="0" x:Name="AppointmentCalendar" 
                  SelectedDatesChanged="AppointmentCalendar_SelectedDatesChanged"/>

        <StackPanel Grid.Column="1" Margin="20,0,0,0">
            <TextBlock Text="Dostępne terminy:" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
            <ListBox x:Name="SlotsList" DisplayMemberPath="TimeOfDay" Height="400"/>
        </StackPanel>
    </Grid>
</UserControl>
